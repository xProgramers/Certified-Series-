# TMDB — "API Read Access Token" (v4) from https://www.themoviedb.org/settings/api
# Leave empty to run with the built-in sample catalog and generated posters.
TMDB_READ_TOKEN=

# Database (libSQL). Local file in development; a Turso URL in production.
DATABASE_URL=file:./data/certified.db
DATABASE_AUTH_TOKEN=

# Session signing secret — at least 32 random characters (openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
